# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SECRET_KEY=your_service_role_or_secret_key

# Google OAuth (from GCP Credentials page)
GOOGLE_CLIENT_ID=your_oauth_client_id
GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# Must exactly match an "Authorized redirect URI" in your GCP OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Gemini (used in a later phase, add now so it's ready)
GEMINI_API_KEY=your_gemini_api_key
